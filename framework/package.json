{
  "name": "@alefbet/framework",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/runtime.js",
  "module": "./dist/runtime.js",
  "exports": {
    ".": "./dist/runtime.js",
    "./runtime": "./dist/runtime.js",
    "./common": "./dist/common.js",
    "./editor": "./dist/editor.js",
    "./dist/runtime.css": "./dist/runtime.css"
  },
  "scripts": {
    "build": "node ../scripts/build.js",
    "dev": "vite build --config vite.runtime.config.js --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "typescript": "^6.0.2",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
