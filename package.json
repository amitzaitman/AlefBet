{
  "name": "alefbet",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "framework",
    "math-pilot"
  ],
  "scripts": {
    "build": "npm run build --workspace=framework",
    "build:pilot": "npm run build --workspace=math-pilot",
    "test": "npm run test --workspace=framework && npm run test --workspace=math-pilot",
    "test:coverage": "npm run test:coverage --workspace=framework",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace=framework",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev:framework": "npm run dev --workspace=framework",
    "dev:pilot": "npm run dev --workspace=math-pilot",
    "e2e": "npm run build && npm run build:pilot && playwright test --output=test-results/games",
    "new:game": "node scripts/create-game.js",
    "setup:browsers": "playwright install --with-deps chromium webkit",
    "verify": "npm run check && npm run e2e",
    "verify:ci": "npm run check && npm run build && npm run check:dist && npm run e2e",
    "check:dist": "node scripts/check-dist.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "typescript-eslint": "^8.58.2"
  }
}
